{
  "manifest_version": 3,
  "name": "GuardDesk 公司端點稽核",
  "version": "0.5.0",
  "description": "記錄公司電腦的網站網址、時間及瀏覽器提供的上傳檔案路徑與 HTTP 結果，套用管理員指定的網站上傳限速。紀錄離線保留，恢復後補送。",
  "key": "",
  "permissions": ["nativeMessaging", "webNavigation", "webRequest", "storage", "unlimitedStorage", "alarms", "proxy"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["upload_selection.js"], "all_frames": true, "run_at": "document_start"}, {"matches": ["http://*/*", "https://*/*"], "js": ["upload_metadata.js"], "world": "MAIN", "all_frames": true, "run_at": "document_start"}],
  "action": {"default_title": "GuardDesk 網址稽核狀態", "default_popup": "popup.html"}
}
