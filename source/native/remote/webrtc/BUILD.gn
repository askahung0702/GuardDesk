import("//webrtc.gni")

rtc_executable("remote_transport_probe") {
  sources = [ "transport_probe.cc" ]
  deps = [
    "//api:create_modular_peer_connection_factory",
    "//api:data_channel_interface",
    "//api:jsep",
    "//api:peer_connection_interface",
    "//api:scoped_refptr",
    "//api:make_ref_counted",
    "//api/environment:environment_factory",
    "//p2p:basic_packet_socket_factory",
    "//rtc_base:network",
    "//rtc_base:logging",
    "//rtc_base:ssl_adapter",
    "//rtc_base:threading",
  ]
}

rtc_library("mf_codec_adapter") {
  # The staging tool copies our MF sources into the owned vendor-tree folder.
  sources = [ "mf_codec_adapter.cc", "mf_codec_adapter.hpp", "codec.cpp", "codec.hpp" ]
  include_dirs = [ "." ]
  suppressed_configs += [ "//build/config/compiler:no_exceptions" ]
  configs += [ "//build/config/compiler:exceptions" ]
  deps = [
    ":frame_protocol",
    "//api/video:video_frame",
    "//common_video",
    "//modules/video_coding:video_codec_interface",
    "//third_party/libyuv",
    "//rtc_base:threading",
  ]
  public_deps = [ "//api/video_codecs:video_codecs_api" ]
  libs = [ "mfplat.lib", "mfuuid.lib", "wmcodecdspuuid.lib", "d3d11.lib", "ole32.lib", "oleaut32.lib" ]
}

rtc_executable("remote_mf_codec_probe") {
  sources = [ "mf_codec_probe.cc" ]
  deps = [ ":mf_codec_adapter", "//api/environment:environment_factory", "//api:make_ref_counted",
    "//api/video:video_frame", "//modules/video_coding:video_codec_interface" ]
}

group("owned_probes") {
